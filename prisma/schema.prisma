// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// Tenant = each teacher's workspace
model Tenant {
  id            String   @id @default(cuid()) @map("_id")
  slug          String   @unique
  name          String
  email         String
  timezone      String   @default("UTC")

  // Design System / Theme (JSON document)
  theme         Json @default("{\"primary\":\"#3b82f6\",\"secondary\":\"#1e40af\",\"accent\":\"#f59e0b\",\"background\":\"#ffffff\",\"textPrimary\":\"#000000\",\"textSecondary\":\"#666666\",\"logoUrl\":null,\"fontFamily\":\"Inter\",\"tagline\":null,\"template\":\"default\"}")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  students      Student[]
  classes       Class[]
  schedules     Schedule[]
  paymentPlans  PaymentPlan[]
  payments      Payment[]
  progressNotes ProgressNote[]
}

// User = both students and teachers. A single account can carry a teacher
// profile and/or a student profile — these are independent add-ons, not an
// exclusive choice, so the same login can eventually do both.
model User {
  id            String   @id @default(cuid()) @map("_id")
  clerkId       String?  @unique
  email         String
  passwordHash  String?
  name          String
  isTeacher     Boolean  @default(false)
  isStudent     Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  // Only meaningful when isTeacher: the workspace this user runs as a teacher.
  tenantId      String?
  createdAt     DateTime @default(now())

  // Notification preferences
  emailNotifications Json @default("{\"paymentConfirmation\":true,\"paymentReminder\":true,\"classReminder\":true,\"paymentReceived\":true}")

  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // A student profile can belong to more than one tenant (one per teacher
  // that has enrolled them), so this is 1-to-many rather than a single
  // studentProfile the old single-role model used.
  students      Student[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

enum StudentStatus {
  // Invited by a teacher but hasn't created/linked an account yet.
  PENDING
  ACTIVE
}

// Student = a user's enrollment relationship with one specific tenant.
// The same person (User) can have several Student rows, one per teacher —
// this is what makes "one student, several teachers" possible later, once
// the public marketplace (rather than teacher-invite-only) is turned on.
model Student {
  id            String        @id @default(cuid()) @map("_id")
  // Null until the invited person creates/links their account.
  userId        String?
  tenantId      String
  name          String
  email         String
  phone         String?
  status        StudentStatus @default(PENDING)
  inviteToken   String?       @unique
  invitedAt     DateTime?
  joinedAt      DateTime?
  createdAt     DateTime      @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  payments      Payment[]
  progressNotes ProgressNote[]

  @@index([tenantId])
  @@index([userId])
}

// Class = type of class (e.g., "Padel Beginners")
model Class {
  id            String   @id @default(cuid()) @map("_id")
  tenantId      String
  name          String
  description   String?
  durationMins  Int      @default(60)
  maxStudents   Int      @default(10)
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules     Schedule[]
  enrollments   Enrollment[]
  paymentPlans  PaymentPlan[]
  progressNotes ProgressNote[]

  @@index([tenantId])
}

// Schedule = recurring weekly slot or one-off specific date
model Schedule {
  id            String    @id @default(cuid()) @map("_id")
  tenantId      String
  classId       String

  // true = repeats weekly on daysOfWeek; false = single specific date
  isRecurring   Boolean   @default(true)
  daysOfWeek    Int[]     // 0=Sun 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat
  timeStart     String    // "HH:MM"
  timeEnd       String    // "HH:MM"
  specificDate  DateTime? // only when isRecurring=false

  isCancelled   Boolean   @default(false)
  createdAt     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]

  @@index([tenantId])
  @@index([classId])
}

// Enrollment = student attending a schedule
model Enrollment {
  id            String   @id @default(cuid()) @map("_id")
  tenantId      String
  studentId     String
  classId       String
  scheduleId    String?
  paidClasses   Int      @default(0)
  status        EnrollmentStatus @default(ACTIVE)
  createdAt     DateTime @default(now())

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  schedule      Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([studentId, classId, scheduleId])
  @@index([tenantId])
  @@index([studentId])
  @@index([classId])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// PaymentPlan = teacher's pricing (5 classes for $50)
model PaymentPlan {
  id            String   @id @default(cuid()) @map("_id")
  tenantId      String
  classId       String
  name          String
  numClasses    Int
  price         Float
  validityDays  Int      @default(90)
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([tenantId])
  @@index([classId])
}

// Payment = student buys class pack
model Payment {
  id              String   @id @default(cuid()) @map("_id")
  tenantId        String
  studentId       String
  planId          String
  amount          Float

  // Class tracking
  totalClasses    Int
  classesUsed     Int      @default(0)

  // Payment details
  status          PaymentStatus @default(PENDING)
  mercadoPagoId   String?
  paidAt          DateTime?
  expiresAt       DateTime?

  // Notes from teacher
  notes           String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan            PaymentPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([expiresAt])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
  REFUNDED
}

// ProgressNote = teacher's notes on student progress
model ProgressNote {
  id            String   @id @default(cuid()) @map("_id")
  tenantId      String
  studentId     String
  classId       String
  note          String
  rating        Int?     // 1-5 scale
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([classId])
}

// --- Marketplace foundations (schema only — not wired to any UI/API yet) ---
// These exist so a User can message another User once the public directory
// is turned on (see lib/feature-flags.ts). Not used while MARKETPLACE_ENABLED
// is off; kept here so the data model doesn't need another migration later.

// Conversation = a DM thread between two accounts (e.g. a prospective
// student messaging a teacher found in the public directory).
model Conversation {
  id                 String   @id @default(cuid()) @map("_id")
  participantIds     String[]
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  createdAt          DateTime @default(now())

  messages           Message[]

  @@index([participantIds])
}

model Message {
  id             String   @id @default(cuid()) @map("_id")
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
